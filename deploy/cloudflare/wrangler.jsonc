// Cloudflare deployment of MLOps MENA Academy. See DEPLOY.md.
//
// Two Workers from one file:
//   top level    -> PRODUCTION: Worker "mlops-academy" on academy.mlopsmena.com
//                   (`wrangler deploy`)
//   env.staging  -> STAGING: Worker "mlops-academy-staging" on academy-staging.mlopsmena.com
//                   (`wrangler deploy --env staging`), with its own containers, Durable
//                   Objects and R2 bucket, and (from its GitHub environment) its own database.
//
// Never rename the production Worker or its container classes: that would create new
// Durable Object namespaces and containers instead of updating the live ones.
// configure-host.mjs can override each environment's hostname from GitHub variables
// (ACADEMY_HOSTNAME, ACADEMY_REDIRECT_HOSTS, SENTRY_ENVIRONMENT) at deploy time.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mlops-academy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    // Only "production" is indexed by search engines (src/robots.ts, and the web build below).
    "ACADEMY_ENVIRONMENT": "production",
    "ACADEMY_HOSTNAME": "academy.mlopsmena.com",
    "EMAIL_FROM": "MLOps MENA Academy <academy@mlopsmena.com>",
    "S3_BUCKET": "academy-private",
    "SENTRY_ENVIRONMENT": "production",
    // Web containers the Worker spreads requests over; at most WebContainer.max_instances.
    "WEB_INSTANCES": "1",
    // Smallest setup, to keep the bill close to the $5 Workers plan: one basic web and API
    // container that sleep after 15 idle minutes. Raise WEB_INSTANCES / instance_type only
    // for an expected spike (see DEPLOY.md, "Capacity and caching").
    "SLEEP_AFTER": "15m"
  },

  "routes": [{ "pattern": "academy.mlopsmena.com", "custom_domain": true }],

  // Sizes for launch (see DEPLOY.md, "Capacity"). standard-1 = 1/2 vCPU, 4 GiB, 8 GB disk.
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../../apps/api/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      // Exactly one: rate limits and the login lockout are in memory.
      "max_instances": 1
    },
    {
      "class_name": "WebContainer",
      "image": "../../apps/web/Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "NEXT_PUBLIC_SITE_URL": "https://academy.mlopsmena.com", "NEXT_PUBLIC_ACADEMY_ENVIRONMENT": "production" },
      "instance_type": "basic",
      // Stateless: the Worker spreads requests over WEB_INSTANCES of these
      // (MAX_WEB_INSTANCES in src/instances.ts must match; a test checks).
      "max_instances": 3,
      // Replace every instance in one step (the default for 2+ instances is 10% first), so
      // the window where old and new builds both serve is as short as possible. The Worker
      // retries /_next/static 404s on the other instances for what remains of it.
      "rollout_step_percentage": 100
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "API", "class_name": "ApiContainer" },
      { "name": "WEB", "class_name": "WebContainer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer", "WebContainer"] }],

  // Scheduled jobs (anonymisation, retention, reminders, profile reviews).
  // Hourly (staging has none, see env.staging): reminder windows are wide enough (jobs/reminders.jobs.ts), and a
  // 15-minute tick would keep the API container from ever sleeping.
  "triggers": { "crons": ["0 * * * *"] },

  "env": {
    "staging": {
      "name": "mlops-academy-staging",
      "vars": {
        // Not production: noindex everywhere, robots.txt "Disallow: /".
        "ACADEMY_ENVIRONMENT": "staging",
        "ACADEMY_HOSTNAME": "academy-staging.mlopsmena.com",
        "EMAIL_FROM": "MLOps MENA Academy (staging) <academy@mlopsmena.com>",
        "S3_BUCKET": "academy-staging-private",
        "SENTRY_ENVIRONMENT": "staging",
        // Staging never emails real people: mail to anyone not on EMAIL_ALLOWLIST goes to
        // EMAIL_REDIRECT_TO instead, with the original recipient in the subject.
        // EMAIL_ALLOWLIST is comma-separated addresses or "@domain" entries.
        "EMAIL_REDIRECT_TO": "admin@mlopsmena.com",
        "EMAIL_ALLOWLIST": "",
        // Staging stays small and cheap: one basic container each, asleep unless someone uses it.
        "WEB_INSTANCES": "1",
        "SLEEP_AFTER": "10m"
      },
      "routes": [{ "pattern": "academy-staging.mlopsmena.com", "custom_domain": true }],
      "containers": [
        {
          "name": "mlops-academy-staging-apicontainer",
          "class_name": "ApiContainer",
          "image": "../../apps/api/Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1
        },
        {
          "name": "mlops-academy-staging-webcontainer",
          "class_name": "WebContainer",
          "image": "../../apps/web/Dockerfile",
          "image_build_context": "../..",
          "image_vars": { "NEXT_PUBLIC_SITE_URL": "https://academy-staging.mlopsmena.com", "NEXT_PUBLIC_ACADEMY_ENVIRONMENT": "staging" },
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "API", "class_name": "ApiContainer" },
          { "name": "WEB", "class_name": "WebContainer" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer", "WebContainer"] }],
      // No Cron Trigger: staging's containers only wake when someone uses staging (an hourly
      // tick woke both for nothing, 24 times a day). Must be an explicit [], or staging would
      // inherit production's crons. Run the jobs on demand with POST /_jobs/tick (src/jobs.ts).
      "triggers": { "crons": [] }
    }
  }
}
