{
  "name": "academy",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @academy/shared build && pnpm --parallel --filter @academy/shared --filter @academy/api --filter @academy/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @academy/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @academy/api db:migrate",
    "db:seed": "pnpm --filter @academy/api db:seed",
    "db:reset": "pnpm --filter @academy/api db:reset",
    "infra:up": "docker compose up -d postgres minio mailpit",
    "infra:down": "docker compose down",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.27",
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
