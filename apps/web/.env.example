# Copy to apps/web/.env.local for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the Next server reaches NestJS (rewrites /api/* and server-side fetches).
API_INTERNAL_URL=http://localhost:4000
# Cookieless analytics (optional): Plausible or Umami
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
