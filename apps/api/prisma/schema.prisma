enum WeeklyHours {
  H_LT_2
  H_2_5
  H_5_10
  H_10_PLUS
}

enum SessionTime {
  WEEKDAY_MORNINGS
  WEEKDAY_EVENINGS
  WEEKEND_MORNINGS
  WEEKEND_EVENINGS
}

enum LearningFormat {
  LIVE
  RECORDED
  HYBRID
}

enum ReferralSource {
  MAIN_SITE
  LINKEDIN
  FACEBOOK
  X_TWITTER
  YOUTUBE
  DISCORD
  TELEGRAM
  WHATSAPP
  FRIEND_COLLEAGUE
  EVENT
  SEARCH
  OTHER
}

enum CourseType {
  FREE
  PAID
}

enum CourseStatus {
  DRAFT
  COMING_SOON
  OPEN
  CLOSED
  ARCHIVED
