  COMPLETED
}

/// Deprecated single level: derived from Course.levels on every save, kept for older API clients.
enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

/// Who a course is for, by career level. A course targets one or more; none means all levels.
