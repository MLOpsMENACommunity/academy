  LEAD
}

enum CourseLanguage {
  EN
  AR
  BILINGUAL
}

enum DeliveryPlatform {
  GOOGLE_MEET
  YOUTUBE_LIVE
}

enum RecordingsPlatform {
  YOUTUBE
  GOOGLE_DRIVE
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_SELECT
  MULTI_SELECT
  YES_NO
  NUMBER
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_REJECTED
  ENROLLED
  REJECTED
  WAITLISTED
}

enum PaymentMethod {
  INSTAPAY
  VODAFONE_CASH
  CARD
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SavedFilterScope {
  APPLICATIONS
  STUDENTS
}

enum FunnelEvent {
  COURSE_VIEW
  APPLY_CLICKED
  REGISTERED
  PROFILE_COMPLETED
  APPLICATION_SUBMITTED
  SHORTLISTED
  PAYMENT_SUBMITTED
  ENROLLED
}

enum ReminderKind {
  H24
  H1
}

// ======================================================================= Users & auth

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  /// Retired: students can no longer change their login email. Always null; kept so the column stays.
  pendingEmail    String?
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  role            Role      @default(STUDENT)
  locale          Locale    @default(en)
  lastLoginAt     DateTime?
  /// Embedded in access tokens; bumping it invalidates every issued token at once.
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// Soft delete: login is blocked immediately; PII is anonymised 30 days later.
  deletedAt       DateTime?
  anonymizedAt    DateTime?

  profile                 Profile?
  applications            Application[]
  enrollments             Enrollment[]
  notifications           Notification[]
  announcementsAuthored   Announcement[]           @relation("AnnouncementAuthor")
  announcementDeliveries  AnnouncementRecipient[]
  eventRegistrations      EventRegistration[]
  eventReminders          EventReminderLog[]
  eventConfirmations      EventConfirmation[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessionProgress         SessionProgress[]
  sessionFeedback         SessionFeedback[]
  submissions             Submission[]             @relation("SubmissionStudent")
  submissionsGraded       Submission[]             @relation("SubmissionGrader")
  assessmentReminders     AssessmentReminderLog[]
  reminderPreferences     ReminderPreference[]
  savedFilters            SavedFilter[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  reviewedPayments        Payment[]                @relation("PaymentReviewer")
  adminNotesWritten       AdminNote[]              @relation("AdminNoteAuthor")
  adminNotesAbout         AdminNote[]              @relation("AdminNoteSubject")
  statusChanges           ApplicationStatusHistory[]
  calendarFeed            CalendarFeed?
  courseInterests         CourseInterest[]
  speakerApplication      SpeakerApplication?      @relation("SpeakerApplicant")
  speakerReviews          SpeakerApplication[]     @relation("SpeakerReviewer")
  speakerProfile          Instructor?
  speakingSlots           SpeakingSlot[]           @relation("SlotBooker")
  speakingSlotsCreated    SpeakingSlot[]           @relation("SlotCreator")

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token; the token itself is never stored.
  tokenHash  String    @unique
  /// All tokens from one login share a family; reuse of a rotated token revokes the family.
  family     String
  expiresAt  DateTime
  /// How and when this login family authenticated (carried through rotation, used for re-auth).
  authMethod String    @default("pwd")
  authTime   DateTime  @default(now())
  /// Replaced by a newer token in the same family (normal rotation).
  rotatedAt  DateTime?
  /// Explicitly invalidated: logout, password change, or theft detection.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  userAgent  String?

  @@index([userId])
  @@index([family])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// The address being verified (the login email; a link for any other address is refused).
  email     String
  returnTo  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ======================================================================= Profile

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ---- Required core
  fullNameEn        String?
  fullNameAr        String?
  phone             String?
  country           String? /// ISO 3166-1 alpha-2
  city              String?
  timezone          String?
  employmentStatus  EmploymentStatus?
  jobTitle          String?
  experienceYears   ExperienceRange?
  primaryArea       Area?
  googleEmail       String?
  preferredLanguage Locale?
  acceptedTermsAt   DateTime?

  // ---- Professional background
  company         String?
  industry        Industry?
  companySize     CompanySize?
  mlExperienceYears ExperienceRange?
  seniority       Seniority?
  secondaryAreas  Area[]

  // ---- Education
  educationLevel    EducationLevel?
  fieldOfStudy      String?
  university        String?
  graduationYear    Int?
  currentlyStudying Boolean?

  // ---- Skills (ratings live in SkillRating)
  cloudPlatforms CloudPlatform[]
  productionTools String[]

  // ---- Goals & availability
  learningGoals     LearningGoal[]
  interestedTopics  Topic[]
  weeklyHours       WeeklyHours?
  preferredTimes    SessionTime[]
  preferredFormat   LearningFormat?

  // ---- Links & portfolio
  linkedinUrl    String?
  githubUrl      String?
  websiteUrl     String?
  kaggleUrl      String?
  huggingfaceUrl String?
  /// Random object key in the private bucket; never the student's name.
  cvKey          String?
  cvUploadedAt   DateTime?

  // ---- Community & consent (explicit, unticked by default)
  referralSource         ReferralSource?
  communityMember        Boolean?
  openToOpportunities    Boolean  @default(false)
  shareWithPartners      Boolean  @default(false)
  marketingEmails        Boolean  @default(false)
  /// Set when the community step is saved: its Yes/No questions were answered explicitly.
  communityAnsweredAt    DateTime?

  /// 0–100, recomputed on every save so it can be filtered and sorted.
  completeness       Int       @default(0)
  coreCompletedAt    DateTime?
  reviewPromptSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  skills SkillRating[]

  @@index([country])
  @@index([experienceYears])
  @@index([mlExperienceYears])
  @@index([seniority])
  @@index([primaryArea])
  @@index([employmentStatus])
  @@index([educationLevel])
  @@index([weeklyHours])
  @@index([openToOpportunities])
  @@index([secondaryAreas], type: Gin)
  @@index([interestedTopics], type: Gin)
  @@index([cloudPlatforms], type: Gin)
}

model SkillRating {
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill
  /// 1–5
  level     Int

  @@id([profileId, skill])
  @@index([skill, level])
}

// ======================================================================= Courses

/// A course instructor or a live-session speaker (one person, one public page at /speakers/{slug}).
model Instructor {
  id         String   @id @default(cuid())
  /// Public page /speakers/{slug}. Null only for rows created before speaker pages existed.
  slug       String?  @unique
  name       String
  nameAr     String?
  titleEn    String
  titleAr    String?
  bioEn      String
  bioAr      String?
  /// http(s) URL or a site path under /speakers/.
  photoUrl   String?
  linkedinUrl String?
  githubUrl  String?
  /// "import" when created by prisma/import-archive.ts; null when created by an admin or the seed.
  source     String?
  /// Hash of the imported entry: an unchanged entry is skipped on the next import.
  importHash String?
  /// The speaker account behind this public profile (speaker portal), if any.
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courses CourseInstructor[]
  events  LiveEvent[]
  /// Sessions they hosted or joined as a guest (besides each session's main speaker).
  coSpeaking LiveEventSpeaker[]
}

model Course {
  id                  String             @id @default(cuid())
  slug                String             @unique
  titleEn             String
  titleAr             String
  shortDescriptionEn  String
  shortDescriptionAr  String
  /// Markdown
  longDescriptionEn   String
  longDescriptionAr   String
  type                CourseType
  /// Whole currency units (EGP has no fractional pricing in practice).
  price               Int                @default(0)
  currency            String             @default("EGP")
  requiresApproval    Boolean            @default(true)
  capacity            Int?
  status              CourseStatus       @default(DRAFT)
  level               CourseLevel        @default(ALL_LEVELS)
  /// In order, Junior → Lead; empty means all levels.
  levels              AudienceLevel[]    @default([])
  /// Show the levels as steps up: "Mid to Senior · Senior to Lead".
  levelProgression    Boolean            @default(false)
  language            CourseLanguage     @default(BILINGUAL)
  startDate           DateTime?
  /// When the catalog switches from "Opening soon" to "Applications open".
  applicationsOpenAt  DateTime?
  applicationDeadline DateTime?
  durationWeeks       Int?
  hoursPerWeek        Int?
  coverImageUrl       String?
  /// Localized markdown blocks: { en, ar }
  targetAudience      Json
  notFor              Json
  /// Markdown shown right after the prerequisites ("Before the course starts").
  preparation         Json     @default("{\"en\":\"\",\"ar\":\"\"}")
  /// Localized lists: { en: string[], ar: string[] }
  learningOutcomes    Json
  prerequisites       Json
  /// [{ titleEn, titleAr, descriptionEn?, descriptionAr? }]
  outline             Json
  /// [{ questionEn, questionAr, answerEn, answerAr }]
  faq                 Json
  /// { liveSessions, recordings, assignments, finalProject, certificate, notesEn?, notesAr? }
  included            Json
  deliveryPlatform    DeliveryPlatform   @default(GOOGLE_MEET)
  recordingsPlatform  RecordingsPlatform @default(YOUTUBE)
  /// Paid courses only. Must be shared with enrolled Google accounts, never "anyone with the link".
  driveFolderUrl      String?
  youtubePlaylistUrl  String?
  /// Short filter tags, e.g. ["mlops", "docker"].
  topics              String[]           @default([])
  /// Which run of the course this is (shown as "Cohort 1 · completed").
  cohortNumber        Int?
  /// Last day of the cohort (completed courses).
  endDate             DateTime?
  /// Set when the cohort ran on another platform, e.g. "zomra.io".
  externalPlatform    String?
  externalUrl         String?
  /// Session recordings are shown to everyone (public YouTube), not only to enrolled students.
  publicRecordings    Boolean            @default(false)
  /// "import" when created by prisma/import-archive.ts.
  source              String?
  importHash          String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  archivedAt          DateTime?

  instructors        CourseInstructor[]
  screeningQuestions ScreeningQuestion[]
  sessions           CourseSession[]
  applications       Application[]
  enrollments        Enrollment[]
  feedback           SessionFeedback[]
  funnelEvents       FunnelEventLog[]
  reminderPreferences ReminderPreference[]
  assessments         Assessment[]

  @@index([status])
  announcements       Announcement[]
  interests           CourseInterest[]
}

model CourseInstructor {
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  order        Int        @default(0)

  @@id([courseId, instructorId])
}

model ScreeningQuestion {
  id       String       @id @default(cuid())
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type     QuestionType
  labelEn  String
  labelAr  String
  helpEn   String?
  helpAr   String?
  /// For select types: [{ value, labelEn, labelAr, requiresDetail? }]
  options  Json?
  required Boolean      @default(true)
  order    Int          @default(0)

  @@index([courseId])
}

/// A live session/lecture. Named CourseSession to avoid confusion with auth sessions.
model CourseSession {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order         Int
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  /// Stored in UTC.
  startsAt      DateTime
  durationMin   Int      @default(90)
  /// Enrolled-only. Never returned to non-enrolled users.
  liveUrl       String?
  recordingUrl  String?
  /// [{ labelEn, labelAr, url }]
  materials     Json     @default("[]")
  assignmentUrl String?
  /// Short filter tags for the recordings library.
  topics        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  progress    SessionProgress[]
  feedback    SessionFeedback[]
  reminders   ReminderLog[]
  assessments Assessment[]

  @@index([courseId, order])
  @@index([startsAt])
}

// ======================================================================= Applications & payments

model Application {
  id              String            @id @default(cuid())
  userId          String
  /// Restrict: users are soft-deleted and anonymised, never hard-deleted, so records stay for accounting.
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId        String
  /// Restrict: courses are archived, not deleted, once anyone has applied.
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  status          ApplicationStatus @default(SUBMITTED)
  /// { [questionId]: string | string[] | number | boolean }
  answers         Json
  /// Copy of the profile at application time.
  profileSnapshot Json
  /// { ref, utm_source, ... }
  source          Json              @default("{}")
  /// Denormalised `source.ref` for filtering.
  ref             String?
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  history    ApplicationStatusHistory[]
  payments   Payment[]
  enrollment Enrollment?
  notes      AdminNote[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([status])
  @@index([createdAt])
  @@index([ref])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?
  actor         User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason        String?
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

model Payment {
  id                String        @id @default(cuid())
  applicationId     String
  /// Restrict: payment records are kept for accounting.
  application       Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  method            PaymentMethod
  amount            Int
  currency          String        @default("EGP")
  transactionRef    String
  /// Upper-case alphanumerics of transactionRef, for duplicate detection.
  transactionRefKey String        @default("")
  senderName        String
  senderPhone       String
  paidAt            DateTime
  /// Random key in the private bucket. Cleared by the retention job; the record stays.
  screenshotKey     String?
  screenshotSha256  String?
  screenshotMime    String?
  screenshotDeletedAt DateTime?
  status            PaymentStatus @default(PENDING_REVIEW)
  verifiedInHistory Boolean       @default(false)
  reviewedById      String?
  reviewedBy        User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime      @default(now())

  @@index([status, createdAt])
  @@index([transactionRefKey])
  @@index([screenshotSha256])
  @@index([applicationId])
}

model Enrollment {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId             String
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  applicationId        String?   @unique
  application          Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  enrolledAt           DateTime  @default(now())
  driveAccessGranted   Boolean   @default(false)
  driveAccessGrantedAt DateTime?
  /// Google address an admin must remove from the Drive folder (old address or deleted account).
  /// Cleared when access is updated or the account is anonymised; kept out of notifications.
  driveRevokeEmail     String?

  projectSubmissions ProjectSubmission[]
  certificate        Certificate?

  @@unique([userId, courseId])
  @@index([courseId])
}

/// Reserved for v2 (no UI yet): a mandatory final project that gates the certificate.
model ProjectSubmission {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  url          String
  notes        String?
  submittedAt  DateTime   @default(now())
  reviewedAt   DateTime?
  passed       Boolean?
}

/// Reserved for v2 (no UI yet).
model Certificate {
  id           String     @id @default(cuid())
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  serial       String     @unique
  issuedAt     DateTime   @default(now())
}

// ======================================================================= Learning experience

model SessionProgress {
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String
  session     CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  completedAt DateTime      @default(now())

  @@id([userId, sessionId])
}

model SessionFeedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Null for end-of-course feedback.
  sessionId String?
  /// sessionId, or "course" for end-of-course feedback: one row per student per scope.
  scopeKey  String         @default("course")
  session   CourseSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, courseId, scopeKey])
  @@unique([userId, sessionId])
  @@index([courseId, sessionId])
  @@index([userId])
}

model ReminderPreference {
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  emailReminders Boolean @default(true)

  @@id([userId, courseId])
}

/// Private calendar subscription link (webcal) for a student's course and live sessions.
/// The token is HMAC(server key, userId:version): it can be shown again without
/// being stored, and bumping `version` resets the link. Only its SHA-256 is
/// stored, to look the feed up from an incoming request.
model CalendarFeed {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  rotatedAt     DateTime?
  lastFetchedAt DateTime?
}

/// Idempotency for reminder emails.
model ReminderLog {
  sessionId String
  session   CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  kind      ReminderKind
  sentAt    DateTime      @default(now())

  @@id([sessionId, userId, kind])
}

// ============================================================ Speaker portal

enum SpeakerArea {
  MLOPS
  LLMOPS
  KUBERNETES
  CLOUD_DEVOPS
  DATA_ENGINEERING
  AI_ARCHITECTURE
  OTHER
}

enum SpeakerFormat {
  TALK
  HANDS_ON
  WORKSHOP
  QA
}

enum SpeakerApplicationStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum SlotStatus {
  OPEN
  BOOKED
  CANCELLED
}

/// One per speaker account: a rejected application is edited and sent again.
model SpeakerApplication {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  user            User                     @relation("SpeakerApplicant", fields: [userId], references: [id], onDelete: Cascade)
  status          SpeakerApplicationStatus @default(SUBMITTED)
  fullName        String
  phone           String
  linkedinUrl     String
  title           String
  company         String                   @default("")
  country         String
  bio             String
  photoUrl        String?
  areas           SpeakerArea[]
  sessionTitle    String
  abstract        String
  format          SpeakerFormat
  language        CourseLanguage
  preferredMonths String[]
  reviewNote      String?
  reviewedById    String?
  reviewedBy      User?                    @relation("SpeakerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  submissions     Int                      @default(1)
  submittedAt     DateTime                 @default(now())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, submittedAt])
}

/// A time the team offers to speakers. Booking is a conditional update (OPEN -> BOOKED),
/// so two speakers can never hold the same slot; eventId is unique too.
model SpeakingSlot {
  id          String     @id @default(cuid())
  startsAt    DateTime
  durationMin Int        @default(60)
  status      SlotStatus @default(OPEN)
  bookedById  String?
  bookedBy    User?      @relation("SlotBooker", fields: [bookedById], references: [id], onDelete: SetNull)
  bookedAt    DateTime?
  title       String?
  abstract    String?
  eventId     String?    @unique
  event       LiveEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?      @relation("SlotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, startsAt])
  @@index([bookedById, status])
  @@index([startsAt])
}

// ======================================================================= Platform

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  titleEn   String
  titleAr   String
  bodyEn    String
  bodyAr    String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model AdminNote {
  id            String       @id @default(cuid())
  authorId      String?
  author        User?        @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  subjectUserId String
  subjectUser   User         @relation("AdminNoteSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime     @default(now())

  @@index([subjectUserId])
  @@index([applicationId])
}

model SavedFilter {
  id        String           @id @default(cuid())
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scope     SavedFilterScope
  name      String
  filters   Json
  createdAt DateTime         @default(now())

  @@index([ownerId, scope])
}

model FunnelEventLog {
  id          String      @id @default(cuid())
  courseId    String
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  event       FunnelEvent
  /// Random per-browser id for anonymous steps; userId once known.
  anonymousId String?
  userId      String?
  createdAt   DateTime    @default(now())

  @@index([courseId, event])
  @@index([createdAt])
}

// ------------------------------------------------------------------ announcements

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// A message from admins to a course's students (in-app + email), delivered from a durable queue.
model Announcement {
  id             String                  @id @default(cuid())
  courseId       String
  course         Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?                   @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  /// Client-generated per send attempt: retrying the same request can't send twice.
  idempotencyKey String                  @unique
  subjectEn      String
  subjectAr      String
  bodyEn         String
  bodyAr         String
  statuses       Json
  createdAt      DateTime                @default(now())
  recipients     AnnouncementRecipient[]
  /// Waiting-list announcements ("the course is open") are delivered to these rows instead.
  waitlist       CourseInterest[]

  @@index([courseId, createdAt])
}

model AnnouncementRecipient {
  id             String         @id @default(cuid())
  announcementId String
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Enrolled students are linked to the learning page, others to their dashboard.
  enrolled       Boolean
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  sentAt         DateTime?
  updatedAt      DateTime       @updatedAt

  @@unique([announcementId, userId])
  @@index([status, announcementId])
}

// ------------------------------------------------------------------ live sessions (free events)

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// A recording's shelf in the library. Course lessons are COURSE_RECORDING without being set.
enum EventCategory {
  HANDS_ON
  INDUSTRY
  COURSE_RECORDING
  TALK
}

enum EventSpeakerRole {
  SPEAKER
  HOST
  GUEST
}

/// A standalone free live session (talk, workshop, AMA), not part of a course.
model LiveEvent {
  id                String              @id @default(cuid())
  slug              String              @unique
  status            EventStatus         @default(DRAFT)
  titleEn           String
  titleAr           String              @default("")
  /// Markdown.
  descriptionEn     String              @default("")
  descriptionAr     String              @default("")
  speakerName       String              @default("")
  speakerNameAr     String              @default("")
  speakerTitleEn    String              @default("")
  speakerTitleAr    String              @default("")
  speakerPhotoUrl   String?
  speakerLinkedinUrl String?
  /// The speaker's profile (page at /speakers/{slug}). The text fields above override it for this session.
  speakerId         String?
  speaker           Instructor?         @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  /// Short filter tags, e.g. ["docker", "ci-cd"].
  topics            String[]            @default([])
  category          EventCategory?
  startsAt          DateTime
  durationMin       Int                 @default(60)
  language          CourseLanguage      @default(BILINGUAL)
  platform          DeliveryPlatform    @default(GOOGLE_MEET)
  /// Shown to registered people shortly before the start (same reveal window as courses).
  liveUrl           String?
  /// Public once set.
  recordingUrl      String?
  coverImageUrl     String?
  /// Empty = unlimited.
  capacity          Int?
  /// "import" when created by prisma/import-archive.ts.
  source            String?
  importHash        String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  registrations     EventRegistration[]
  reminders         EventReminderLog[]
  confirmations     EventConfirmation[]
  /// Hosts and guests besides the main speaker, in display order.
  coSpeakers        LiveEventSpeaker[]
  speakingSlot      SpeakingSlot?

  @@index([status, startsAt])
  @@index([speakerId])
  @@index([topics], type: Gin)
}

/// A host or guest of a live session, besides its main speaker (LiveEvent.speakerId).
model LiveEventSpeaker {
  eventId      String
  event        LiveEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor       @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  role         EventSpeakerRole @default(GUEST)
  order        Int              @default(0)

  @@id([eventId, instructorId])
  @@index([instructorId])
}

model EventRegistration {
  id        String    @id @default(cuid())
  eventId   String
  event     LiveEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model EventReminderLog {
  eventId String
  event   LiveEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind    ReminderKind
  sentAt  DateTime     @default(now())

  @@id([eventId, userId, kind])
}

/// The registration confirmation goes out once per person and session, even if they unregister and register again.
model EventConfirmation {
  eventId String
  event   LiveEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt  DateTime  @default(now())

  @@id([eventId, userId])
  @@index([userId])
}

/// The waiting list: people who asked to hear when a course opens (signed in or not).
model CourseInterest {
  id             String          @id @default(cuid())
  courseId       String
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Set when a signed-in student joined.
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Lower-cased. For signed-in students, their account email at the time they joined.
  email          String
  locale         Locale          @default(en)
  createdAt      DateTime        @default(now())
  /// When the "the course is open" email was sent to this person.
  notifiedAt     DateTime?
  /// The announcement that notified (or is notifying) this person, with its delivery state.
  announcementId String?
  announcement   Announcement?   @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  deliveryStatus DeliveryStatus?
  attempts       Int             @default(0)

  @@unique([courseId, email])
  @@index([userId])
  @@index([email])
  @@index([deliveryStatus])
}

// ================================================================= Assessments
// Quizzes (auto-graded), labs and assignments (graded by the course team).
// The answer key (QuizOption.correct, explanations) never leaves the API to a
// student before the assessment's reveal rule allows it.

enum AssessmentType {
  QUIZ
  LAB
  ASSIGNMENT
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionKind {
  GITHUB_REPO
  DRIVE_LINK
  PDF
  LINK
}

enum ScoringPolicy {
  BEST
  LAST
}

enum RevealPolicy {
  NEVER
  AFTER_SUBMIT
  AFTER_DUE
}

enum QuizQuestionKind {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

/// Result of the unauthenticated "is this GitHub repository public?" check.
enum RepoCheck {
  PUBLIC
  NOT_PUBLIC
  UNVERIFIED
}

model Assessment {
  id                   String           @id @default(cuid())
  courseId             String
  course               Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Null: a course-level assessment (e.g. the midpoint quiz or the capstone).
  sessionId            String?
  session              CourseSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type                 AssessmentType
  status               AssessmentStatus @default(DRAFT)
  order                Int              @default(0)
  titleEn              String
  titleAr              String
  instructionsEn       String           @default("")
  instructionsAr       String           @default("")
  dueAt                DateTime?
  /// Late work is accepted (and flagged) unless this is off.
  allowLate            Boolean          @default(true)
  maxPoints            Int              @default(100)
  passPercent          Int              @default(70)
  countsForCertificate Boolean          @default(false)
  /// Labs and assignments only.
  submissionKind       SubmissionKind?
  /// Quizzes only. 0 = unlimited.
  attemptsAllowed      Int              @default(1)
  scoring              ScoringPolicy    @default(BEST)
  revealAnswers        RevealPolicy     @default(AFTER_SUBMIT)
  timeLimitMin         Int?
  shuffle              Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  questions   QuizQuestion[]
  submissions Submission[]
  reminders   AssessmentReminderLog[]

  @@index([courseId, status, order])
  @@index([sessionId])
  @@index([status, dueAt])
}

model QuizQuestion {
  id            String           @id @default(cuid())
  assessmentId  String
  assessment    Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order         Int
  kind          QuizQuestionKind
  promptEn      String
  promptAr      String
  weight        Int              @default(1)
  explanationEn String?
  explanationAr String?
  options       QuizOption[]

  @@index([assessmentId, order])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  labelEn    String
  labelAr    String
  correct    Boolean      @default(false)

  @@index([questionId, order])
}

model Submission {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("SubmissionStudent", fields: [userId], references: [id], onDelete: Cascade)
  /// 1, 2, 3… per student. Labs and assignments keep one row that resubmissions update.
  attempt      Int        @default(1)
  /// Quiz answers: { [questionId]: optionId[] }.
  answers      Json?
  url          String?
  fileKey      String?
  fileName     String?
  fileDeletedAt DateTime?
  note         String?
  /// The student ticked "My repository is public" / "Anyone with the link can view".
  attested     Boolean    @default(false)
  repoCheck    RepoCheck?
  /// Quizzes: when the attempt was opened (the time limit runs from here).
  startedAt    DateTime   @default(now())
  /// Null while a quiz attempt is in progress.
  submittedAt  DateTime?
  late         Boolean    @default(false)
  score        Float?
  maxScore     Int
  gradedAt     DateTime?
  gradedById   String?
  gradedBy     User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  feedback     String?
  rubricNotes  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, userId, attempt])
  @@index([userId])
  @@index([assessmentId, submittedAt])
}

/// One "due in 24 hours" email per assessment and student.
model AssessmentReminderLog {
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt       DateTime   @default(now())

  @@id([assessmentId, userId])
  @@index([userId])
}
