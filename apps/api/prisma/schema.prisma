// MLOps MENA Academy data model.
// Enum values mirror packages/shared/src/enums.ts (enforced by test/enums-sync.spec.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================================= Enums

enum Locale {
  en
  ar
}

enum Role {
  STUDENT
  ADMIN
  SPEAKER
}

enum EmploymentStatus {
  EMPLOYED_FULL_TIME
  EMPLOYED_PART_TIME
  FREELANCER
  STUDENT
  JOB_SEEKING
  OTHER
}

enum ExperienceRange {
  Y0_1
  Y1_3
  Y3_5
  Y5_10
  Y10_PLUS
}

enum Area {
  ML_ENGINEERING
  MLOPS
  LLMOPS_AI_ENGINEERING
  DATA_SCIENCE
  DATA_ENGINEERING
  SOFTWARE_BACKEND
  DEVOPS_PLATFORM_SRE
  RESEARCH
  STUDENT
  OTHER
}

enum Industry {
  FINTECH
  TELECOM
  HEALTHCARE
  ECOMMERCE
  GOVERNMENT
  CONSULTING
  ACADEMIA
  OTHER
}

enum CompanySize {
  S1_10
  S11_50
  S51_200
  S201_1000
  S1000_PLUS
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD_STAFF
  MANAGER
  HEAD_DIRECTOR
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
  BOOTCAMP_SELF_TAUGHT
}

enum Skill {
  PYTHON
  SQL
  LINUX_BASH
  GIT
  DOCKER
  KUBERNETES
  CI_CD
  AWS
  GCP
  AZURE
  ML_FUNDAMENTALS
  DEEP_LEARNING
  LLMS_RAG
  AGENTS
  MLOPS_TOOLING
  MONITORING_OBSERVABILITY
}

enum CloudPlatform {
  AWS
  GCP
  AZURE
  ORACLE
  ALIBABA
  OTHER
}

enum LearningGoal {
  FIRST_ML_JOB
  MOVE_TO_MLOPS
  LEVEL_UP_SENIOR
  LEAD_TEAM
  BUILD_PRODUCT
  FREELANCING
  RESEARCH
}

enum Topic {
  MLOPS
  LLMOPS
  KUBERNETES
  RAG
  AGENTS
  AI_ARCHITECTURE
  CLOUD
  DATA_ENGINEERING
  COMPUTER_VISION
  NLP
  DEEP_LEARNING
  MONITORING
  SECURITY_GOVERNANCE
