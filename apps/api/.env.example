# Copy to apps/api/.env for local development (`pnpm dev`).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://academy:academy@localhost:5433/academy?schema=public

# Public origin of the web app (used in emails, OAuth redirects, CORS).
WEB_URL=http://localhost:3000
CORS_ORIGINS=

# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32+
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Leave empty for host-only cookies. COOKIE_SECURE defaults to true in production.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Google OAuth (optional locally). Redirect URI: ${WEB_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# smtp (Mailpit locally) | resend (production) | log (prints to console)
EMAIL_PROVIDER=smtp
EMAIL_FROM="MLOps MENA Academy <academy@mlopsmena.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Private bucket: MinIO locally, Cloudflare R2 in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=academy-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

SEED_ADMIN_EMAIL=admin@academy.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026

SENTRY_DSN=
JOBS_ENABLED=true
